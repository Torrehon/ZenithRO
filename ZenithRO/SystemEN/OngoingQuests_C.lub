QuestInfoList_C = {
	--[[ Quest Info Format:
	[<ID>] = {
		Title = "",
		Description = {
			""
		},
		Summary = "", -- If you don't need any arguments below, remove the , in this line
		-- Optional values:
		CoolTimeQuest = 1, -- Shows the Quest in a separate tab (if supported by the client)
		NpcSpr = "<NPC_Sprite>",
		NpcNavi = "<MapName>",
		RewardEXP = "0",
		RewardJEXP = "0",
		NpcPosX = 0,
		NpcPosY = 0,
		RewardItemList = {
			{ ItemID = 0, ItemNum = 1 },
			{ ItemID = 0, ItemNum = 1 },
			{ ItemID = 0, ItemNum = 1 }
		}
	},
	]]
	-------- Start of custom entries: -----------
	[80001] = {
		Title = "Sewage Novice Rescue",
		Description = {
			"I have promised to help the novices",
			"lost in the Prontera Culverts.",
			"I must find them all to earn a reward."
		},
		Summary = "Bring 20 Red Potions to the novices.",
		NpcName = "Culvert Guardian",
	},
	[80002] = {
		Title = "Mutant Bug Extermination",
		Description = {
			"The boss of the culvert bugs,",
			"a powerful Mutant Thief Bug, is hiding",
			"in the deepest corner.",
			"I must exterminate it to save the city."
		},
		Summary = "Defeat the Mutant Thief Bug.",
		Hunt1 = "Mutant Male Bug",
		NpcName = "Prontera Knight",
	},
	[80003] = {
		Title = "Culvert Bounty Claim",
		Description = {
			"The mutant has been slain!",
			"I must report back to the Guard",
			"at the entrance of the Culvert",
			"to claim my reward."
		},
		Summary = "Return to the Culvert Guardian.",
		NpcName = "Culvert Guardian",
	},
	[80020] = {
		Title = "Minji Sacrifice",
		Description = {
			"The grandmother Kyung at Payon Archer",
			"Village is mourning her granddaughter.",
			"I must find the ancient altar in the",
			"Payon Caves and purify the darkness."
		},
		Summary = "Purify the Tormented Weaver.",
		Hunt1 = "Tormented Weaver",
		NpcName = "Grandmother Kyung",
	},
	[80021] = {
		Title = "Payon Purification",
		Description = {
			"The shadows in Payon Dungeon never",
			"truly sleep. I must return to the altar",
			"to keep Minji spirit at peace."
		},
		Summary = "Defeat the Tormented Weaver.",
		Hunt1 = "Tormented Weaver",
		NpcName = "Grandmother Kyung",
	},
	[80030] = {
		Title = "Coal Mines Culling",
		Description = {
			"Clear the path towards the 3rd level",
			"so Garrick and his team mates can ",
			"start looking for the Orichalcum."
		},
		Summary = "Defeat the Targets.",
		Hunt1 = "Skeleton Worker",
		NpcName = "Garrick the Surveyor",
	},
	[80031] = {
		Title = "Orichalcum Extraction",
		Description = {
			"The Orichalcum vein must be somewhere",
			"at the northwestern part of the 3rd floor",
			"Grab an Old Pick from a Skeleton",
			"Worker and start mining!"
		},
		Summary = "Mine for Orichalcum.",
		NpcName = "Orichalcum Vein",
	},
	[80032] = {
		Title = "Mine Spirit's Vengeance",
		Description = {
			"Stop the Mine Spirit before it",
			"makes the mines collapse!"
		},
		Summary = "Defeat the Mine Spirit",
		Hunt1 = "Mine Spirit",
		NpcName = "Orichalcum Vein",
	},
	[80033] = {
		Title = "Orichalcum Delivery",
		Description = {
			"You conquered the mines.",
			"Go back to Garrick and",
			"give him the Orichalcum."
		},
		Summary = "Talk to Garrick",
		NpcName = "Garrick the Surveyor",
	},
	[80040] = {
		Title = "Byalan Culling",
		Description = {
			"The archaeological team needs you",
			"to clear the way to the 3rd floor",
			"by defeating some sea monsters."
		},
		Summary = "Defeat the Targets.",
		Hunt1 = "Marc",
		Hunt2 = "Swordfish",
		Hunt3 = "Phen",
		NpcName = "Archeologist Dan",
	},
	[80041] = {
		Title = "Deep Sea Excavation",
		Description = {
			"Join Alard's competition and then",
			"help the Chief Archeologist find the",
			"Trident of the Depths in the kelp."
		},
		Summary = "Find the Trident of the Depths.",
		NpcName = "Alard",
	},
	[80042] = {
		Title = "Mermaid of the Depths",
		Description = {
			"Breach the seal with the Trident and",
			"protect the expedition from the horde",
			"of sea creatures."
		},
		Summary = "Defeat the Mermaid of the Depths.",
		Hunt1 = "Depths Mermaid",
		NpcName = "Chief Archeologist",
	},
	[80043] = {
		Title = "Byalan Expedition Complete",
		Description = {
			"You secured the depths.",
			"Speak to the Chief Archeologist",
			"to warp back and receive rewards."
		},
		Summary = "Talk to the Chief Archeologist",
		NpcName = "Chief Archeologist",
	},
	[90001] = {
		Title = "Soul Quest: The Dawn Awakening",
		Description = {
			"Scholar at Prontera Library recognized your Dawn Weapon.",
			"He asked you to gather magical energy from 4 sanctuaries:",
			"- Prontera Field (prt_fild07 226, 112)",
			"- Alberta Field (pay_fild03 162, 215)",
			"- Morocc Field (moc_fild11 140, 242)",
			"- Payon Field (pay_fild02 104, 245)"
		},
		Summary = "Absorb magic energy at the 4 sanctuaries.",
		NpcName = "Scholar",
	},
	[90002] = {
		Title = "Soul Quest: Return to Scholar",
		Description = {
			"Your Dawn Weapon is fully charged with ancient magic.",
			"Return to the Scholar in Prontera Library",
			"to report your discovery."
		},
		Summary = "Report back to Scholar in Prontera Library.",
		NpcName = "Scholar",
	},
	[90003] = {
		Title = "Soul Quest: The Celestial Call",
		Description = {
			"Scholar instructed you to travel to the high territory",
			"of Geffen Field (gef_fild07 182, 240).",
			"Keep your Dawn Weapon equipped so the gathered magic",
			"can react with the firmament."
		},
		Summary = "Travel to gef_fild07 (182, 240) with your Dawn Weapon.",
		NpcName = "Scholar",
	},
	[90004] = {
		Title = "Soul Quest: Pantheon of Heroes",
		Description = {
			"You have arrived at the Pantheon of Heroes (1@4tro).",
			"Speak to the Einherjar hero corresponding to your job class",
			"to claim your ancient Hero Soul."
		},
		Summary = "Claim your Hero Soul from the Einherjar.",
		NpcName = "Einherjar",
	},

