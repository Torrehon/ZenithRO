; Settings engine related settings
[settings]

; Save registry settings per user.
; Values:
;       0: No (saves to HKLM)
;       1: Yes (saves to HKCU)
; Default:
;       0
; Note: Do NOT change this setting, unless you REALLY know what you
; are doing.
HKLMtoHKCU=0

; Select Lua settings folder.
; Values:
;       0: data\ (legacy)
;       1: savedata\ (current)
; Default:
;       1
LuaSaveData=1

; Interface language ID.
; Values:
;       1024: default user language (recommended)
;       1028: zh-HANT
;       1029: cs-CZ
;       1031: de-DE
;       1033: en-US
;       1034: es-ES
;       1036: fr-FR
;       1041: ja-JP
;       1046: pt-BR
;       1049: ru-RU
;       1054: th-TH
;       2048: default system language
;       2052: zh-HANS
; Default:
;       1024
; Note: If you install an additional language resource, you may use
; its LANGID as well.
; Note: Non-default languages may not display correctly on all OS
; versions or configurations.
UILang=1024

; [DirectX 7] Minimum horizontal display resolution (pixel).
; Values:
;       0: no limit
; Default:
;       0
; Note: Previous default value was 640.
DispMinW[0]=640

; [DirectX 7] Minimum vertical display resolution (pixel).
; Values:
;       0: no limit
; Default:
;       664
; Note: Previous default value was 480.
DispMinH[0]=664

; [DirectX 7] Maximum horizontal display resolution (pixel).
; Values:
;       0: no limit
; Default:
;       2048
; Note: Previous default value was 0.
DispMaxW[0]=2048

; [DirectX 7] Maximum vertical display resolution (pixel).
; Values:
;       0: no limit
; Default:
;       1440
; Note: Previous default value was 0.
DispMaxH[0]=1440

; [DirectX 9] Minimum horizontal display resolution (pixel).
; Values:
;       0: no limit
; Default:
;       0
DispMinW[1]=0

; [DirectX 9] Minimum vertical display resolution (pixel).
; Values:
;       0: no limit
; Default:
;       664
DispMinH[1]=664

; [DirectX 9] Maximum horizontal display resolution (pixel).
; Values:
;       0: no limit
; Default:
;       0
DispMaxW[1]=0

; [DirectX 9] Maximum vertical display resolution (pixel).
; Values:
;       0: no limit
; Default:
;       0
DispMaxH[1]=0

; Disable specific DirectX versions.
; Bitmask:
;       &1: DirectX 7
;       &2: DirectX 9
; Default:
;       0
PolicyDisableDirectXVersion=0
